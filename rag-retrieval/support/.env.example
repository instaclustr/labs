# Copy this file to .env and fill in real values. .env is gitignored.

# --- Instaclustr OpenSearch ---
OPENSEARCH_HOST=your-cluster-host.instaclustr.com
OPENSEARCH_PORT=9200
OPENSEARCH_USER=your-username
OPENSEARCH_PASSWORD=your-password
OPENSEARCH_SSL=true

# Per-task index names -- change these if you share a cluster with others
# (e.g. append your name/initials so you don't collide with other users of the cluster).
OPENSEARCH_HYBRID_INDEX=recipes-hybrid
OPENSEARCH_RECIPE_BM25_INDEX=recipes-bm25
OPENSEARCH_RECIPE_VECTOR_INDEX=recipes-vector
# Baseline Vector RAG and Baseline BM25 RAG (baseline vector/BM25 indexes over the recipe dataset)
OPENSEARCH_VECTOR_RECIPES_BASELINE_INDEX=recipes-vector-baseline
OPENSEARCH_BM25_RECIPES_BASELINE_INDEX=recipes-bm25-baseline
# Governance Tiering (governance audit trail + hot/LT tiering thresholds)
OPENSEARCH_AUDIT_INDEX=recipes-audit-log
TIER_MIN_HOT_SCORE=15.0
TIER_MIN_HOT_CANDIDATES=3
# Operationalize Production (production hardening: audit-log retention + governance monitoring)
AUDIT_RETENTION_DAYS=180
GOVERNANCE_ALERT_LOOKBACK_HOURS=24
GOVERNANCE_MAX_ESCALATION_RATE=0.5

# --- LLM provider selection ---
# "bedrock" (default) or "openai". Every task calls the same generate()
# function regardless -- this just picks which backend it talks to.
LLM_PROVIDER=bedrock

# --- Amazon Bedrock (used when LLM_PROVIDER=bedrock) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Exact Bedrock model ID from your account's Model access page, e.g.:
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_ID=

# --- OpenAI / OpenAI-compatible (used when LLM_PROVIDER=openai) ---
# No AWS account needed -- use this if you don't have Bedrock access.
# OPENAI_BASE_URL also accepts any OpenAI-compatible endpoint, not just
# OpenAI itself (e.g. a self-hosted or alternate provider's /v1 URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# --- HuggingFace (optional: higher rate limits when downloading the embedding model) ---
HF_TOKEN=

# --- Embeddings / NER (defaults are fine for most machines) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
NER_SERVICE_URL=http://127.0.0.1:8000/ner
