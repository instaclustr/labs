{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Temperature & anomalies (per sensor)",
      "description": "Lines = per-sensor temperature (from the events table). Red dots = detected anomalies (from the anomalies table).",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "anomaly" },
            "properties": [
              { "id": "custom.drawStyle", "value": "points" },
              { "id": "custom.pointSize", "value": 9 },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 1,
          "rawSql": "SELECT toStartOfSecond(ts) AS time, avgIf(value, entity = 'sensor-1') AS \"sensor-1\", avgIf(value, entity = 'sensor-2') AS \"sensor-2\", avgIf(value, entity = 'sensor-3') AS \"sensor-3\" FROM events WHERE $__timeFilter(ts) GROUP BY time ORDER BY time"
        },
        {
          "refId": "B",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 1,
          "rawSql": "SELECT ts AS time, value AS anomaly FROM anomalies WHERE $__timeFilter(ts) ORDER BY time"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Anomalies in range",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
          "editorType": "sql",
          "queryType": "table",
          "format": 2,
          "rawSql": "SELECT count() AS anomalies FROM anomalies WHERE $__timeFilter(ts)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["stream-to-search"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Anomaly Detection — sensor fleet",
  "uid": "s2s-anomaly",
  "version": 1,
  "weekStart": ""
}
